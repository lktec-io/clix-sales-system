# Set to "production" on the real server; local dev keeps "development".
# When NODE_ENV=production, only FRONTEND_URL is allowed by CORS.
# When NODE_ENV is anything else, http://localhost:5173 is also allowed
# automatically (see backend/config/cors.js) — no separate dev URL needed.
NODE_ENV=development
PORT=4001

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use two DIFFERENT values — never reuse the access secret as the refresh secret.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Optional — the Platform Admin Portal (Phase 3) needs its own signing
# secrets so a tenant JWT can never be used on a /platform/* route and vice
# versa. If left blank, they're derived from JWT_ACCESS_SECRET (still fully
# isolated from tenant tokens, just not independently rotatable) — the app
# boots fine either way. Set both explicitly in production when convenient.
JWT_PLATFORM_ACCESS_SECRET=
JWT_PLATFORM_REFRESH_SECRET=
JWT_PLATFORM_ACCESS_EXPIRES_IN=15m
JWT_PLATFORM_REFRESH_EXPIRES_IN=7d

# https://sales.clixworks.co.tz in production; http://localhost:5173 for local dev.
FRONTEND_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sales.clixworks.co.tz

# Primary storage for uploaded images (avatars, company logo, product
# images) — required in production. Leave blank in local dev to fall back
# to local-disk uploads automatically (see backend/config/cloudinary.js).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment architecture (Phase 6/6B). Leave PAYMENT_PROVIDER=manual (or
# blank) to keep the app on the built-in manual/offline provider (tenant
# requests an upgrade, a platform admin confirms payment received by an
# existing offline channel — see
# backend/services/paymentProviders/manualPaymentProvider.js). Set it to
# "azampay" ONLY once every AZAMPAY_* value below is filled in AND you have
# confirmed the callback authentication mechanism against AzamPay's own
# merchant documentation (see azampayPaymentProvider.js's header comment —
# this codebase's webhook signature check is unverified against a live
# AzamPay account and fails closed until AZAMPAY_CALLBACK_SECRET is set).
PAYMENT_PROVIDER=manual

# Required only when PAYMENT_PROVIDER=azampay. Obtain appName/clientId/
# clientSecret by registering as an AzamPay merchant (sandbox first) at
# https://developers.azampay.co.tz — this codebase never invents or
# hardcodes these. Leaving them blank keeps PAYMENT_PROVIDER effectively
# on "manual" (azampayPaymentProvider.js refuses to fetch a token without
# all three).
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
# Sandbox defaults shown — switch to AzamPay's production URLs only once
# you're ready to move off sandbox testing.
AZAMPAY_AUTH_URL=https://authenticator-sandbox.azampay.co.tz
AZAMPAY_CHECKOUT_URL=https://sandbox.azampay.co.tz
# Confirm the ACTUAL callback-authentication mechanism AzamPay uses for
# your merchant account before setting this — see
# azampayPaymentProvider.js's verifyWebhookSignature() and its header
# comment. Left blank, every callback is rejected (fail closed), which is
# the safe default until that mechanism is confirmed.
AZAMPAY_CALLBACK_SECRET=

# Beem Africa SMS (repair notifications). Leave SMS_PROVIDER unset (or
# "none") to keep SMS disabled entirely — every send attempt is then
# logged as "skipped_not_configured" instead of failing or crashing (see
# backend/services/smsProviders/). Enter real credentials directly on the
# VPS; nothing here is invented or hardcoded. The variable names below are
# a best guess at what Beem's API needs (api key, secret key, an approved
# sender ID, and the API base URL) — confirm the EXACT names and values
# against Beem's own current developer documentation before relying on
# them, and see beemSmsProvider.js's header comment: its send() call is
# not yet implemented against Beem's live API, since that contract hasn't
# been verified.
SMS_PROVIDER=none
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=
BEEM_BASE_URL=
# Per-tenant cap on SMS sends per rolling hour, to avoid runaway cost from
# a bug or abuse. 100/hour is a placeholder default, not a Beem-specified
# value — adjust to whatever your actual SMS budget/plan supports.
SMS_RATE_LIMIT_PER_HOUR=100
